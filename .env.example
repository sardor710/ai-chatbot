# ==========================================
# Telegram API Credentials
# Get your API ID and HASH from https://my.telegram.org
# ==========================================
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
TELEGRAM_PHONE=

# Telethon session file name (stored locally, e.g. telegram_ai.session)
TELEGRAM_SESSION=telegram_ai

# ==========================================
# LLM Provider Configuration (OpenAI Compatible)
# ==========================================
LLM_API_KEY=
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini
MAX_RESPONSE_TOKENS=300

# ==========================================
# Database Configuration
# SQLite with async support
# ==========================================
DATABASE_URL=sqlite+aiosqlite:///data/app.db

# ==========================================
# Autopilot & Safety Controls
# ==========================================
# Master switch for autonomous replies (true / false)
AUTOPILOT_ENABLED=false

# Dry run mode (simulate responses in logs without sending to Telegram)
DRY_RUN=true

# Draft mode (generate and persist drafts without sending)
DRAFT_MODE=false

# Specific chat type automation controls
PRIVATE_CHAT_AUTOPILOT=false
GROUP_CHAT_AUTOPILOT=false

# ==========================================
# Personality & Identity
# ==========================================
# The Telegram username of the account owner (e.g. @mlsv06)
OWNER_USERNAME=@mlsv06
# Telegram user ID of the owner account (used to verify /autopilot_on and other owner-only commands)
OWNER_USER_ID=

# Bot usernames for anonymous chat workflow (comma-separated for multiple bots)
ANONYMOUS_BOT_USERNAMES=anonrubot,anonim
ANONYMOUS_BOT_USERNAME=anonrubot

# ==========================================
# Delays, Pacing & Memory Limits
# ==========================================
MIN_REPLY_DELAY_SECONDS=1.5
MAX_REPLY_DELAY_SECONDS=5.0
MAX_HISTORY_MESSAGES=30

# ==========================================
# Logging
# ==========================================
LOG_LEVEL=INFO
DASHBOARD_ENABLED=true
DASHBOARD_PORT=8080
